{"archive":"dialogs.bin","records":[{"sourcePath":"act1/heli/heli1/blocking_hint.xmlb","sourceSha256":"5aa0dbd2b3b6c2570acbd7b03f07784361367756e56d58dbefc9c4f2a5a84ede","bytes":271,"tree":{"offset":8,"tag":"dialog_def","attributes":[],"children":[{"offset":24,"tag":"dialog","attributes":[["autohide","true"],["cancancel","false"],["debounce","0"],["help2","$MENU_ACCEPT Continue"],["hidehud","false"],["hud","false"],["text","Blocking can protect you from incoming attacks.\\nHold $BLOCK to block."]],"children":[]}]}},{"sourcePath":"act1/heli/heli1/fury_1.xmlb","sourceSha256":"2d23cf0fbbba162c8e01622bab6107245fa7058da359245f9643c96ded6625c4","bytes":321,"tree":{"offset":8,"tag":"dialog_def","attributes":[],"children":[{"offset":24,"tag":"dialog","attributes":[["autohide","true"],["cancancel","true"],["debounce","0"],["help2","$MENU_ACCEPT Continue"],["hidehud","false"],["hud","false"],["hud_subtitle","true"],["text","Gentlemen, this is Colonel Nick Fury.  I'm on the main bridge, but I'm not sure how long I'll last."]],"children":[]}]}},{"sourcePath":"act1/heli/heli1/fury_2.xmlb","sourceSha256":"7deb01fdd949054d96c624eeb48fd6ed3d4da7ba7593a9c3efbf8be33963d1c9","bytes":252,"tree":{"offset":8,"tag":"dialog_def","attributes":[],"children":[{"offset":24,"tag":"dialog","attributes":[["autohide","true"],["cancancel","true"],["debounce","0"],["help2","$MENU_ACCEPT Continue"],["hidehud","false"],["hud","false"],["hud_subtitle","true"],["text","Get here ASAP . . . Fury, out!"]],"children":[]}]}},{"sourcePath":"act1/heli/heli1/melee_hint.xmlb","sourceSha256":"cab220a319ff57501961278b9d000b71136e00d7d0eb2caccbfdc2e1e94872e4","bytes":291,"tree":{"offset":8,"tag":"dialog_def","attributes":[],"children":[{"offset":24,"tag":"dialog","attributes":[["autohide","true"],["cancancel","true"],["debounce","0"],["help2","$MENU_ACCEPT Continue"],["hidehud","false"],["hud","false"],["text","Press $ATTACK for quick attacks, $SMASH for heavy attacks.\\nHold $SMASH to charge attacks."]],"children":[]}]}},{"sourcePath":"act1/heli/heli1/orbs1.xmlb","sourceSha256":"b5b6406db6903bf51ac790c0d78bc2408cd8a451f38865c102d21c6211282552","bytes":250,"tree":{"offset":8,"tag":"dialog_def","attributes":[],"children":[{"offset":24,"tag":"dialog","attributes":[["autohide","true"],["cancancel","true"],["debounce","0"],["help2","$MENU_ACCEPT Continue"],["hidehud","false"],["hud","false"],["text","Red Orbs restore Health\\nBlue Orbs restore Energy"]],"children":[]}]}},{"sourcePath":"act1/heli/heli1/power_hint.xmlb","sourceSha256":"95afd7370a2f77668fd42022c8d68648c9b734a38ab3396cd676f79af86de85b","bytes":858,"tree":{"offset":8,"tag":"dialog_def","attributes":[],"children":[{"offset":24,"tag":"dialog","attributes":[["autohide","true"],["cancancel","false"],["debounce","0"],["help2","$MENU_ACCEPT Continue"],["hidehud","false"],["hud","false"],["platform","gc"],["text","If you hold down $POWER, you can choose $GUARD , $MOVE , $ATTACK , or $SMASH to activate a mutant power.\\n\\nUsing mutant powers drains some of your Energy.  In the corner of your screen, the blue bar next to your Active Hero's head indicates how much Mutant Energy you have left.\\n\\nHold down $GUARD and use $ALLY to replenish your Energy with Energy Packs."]],"children":[]},{"offset":104,"tag":"dialog","attributes":[["autohide","true"],["cancancel","false"],["debounce","0"],["help2","$MENU_ACCEPT Continue"],["hidehud","false"],["hud","false"],["platform","ps2"]],"children":[]},{"offset":176,"tag":"dialog","attributes":[["autohide","true"],["cancancel","false"],["debounce","0"],["help2","$MENU_ACCEPT Continue"],["hidehud","false"],["hud","false"],["platform","xbox"]],"children":[]},{"offset":248,"tag":"dialog","attributes":[["autohide","true"],["cancancel","false"],["debounce","0"],["help2","$MENU_ACCEPT Continue"],["hidehud","false"],["hud","false"],["text","Hold $POWER and press $ATTACK or $SMASH to use Powers."]],"children":[]}]}},{"sourcePath":"act1/heli/heli1/switching_hint.xmlb","sourceSha256":"ec35cfa6b420f